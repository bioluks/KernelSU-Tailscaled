#!/system/bin/sh
# shellcheck disable=SC3043
SCRIPT_DIR=${0%/*}
. "$SCRIPT_DIR/common.sh"
. "$SCRIPT_DIR/system-dns.sh"
FRESH_MARKER="$TS_DIR/fresh-defaults.pending"
HOSTNAME_MARKER="$TS_DIR/hostname.initialized"
FRESH_APPLIED="$RUN_DIR/fresh-defaults.applied"

hostname_slug() {
  printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | sed 's/[^a-z0-9-]/-/g; s/--*/-/g; s/^-//; s/-$//' | cut -c 1-63 | sed 's/-$//'
}

initialize_hostname() {
  [ -f "$TS_DIR/migration-origin" ] && return 0
  [ -f "$FRESH_MARKER" ] || return 0
  local persisted prefs current raw_name hostname
  persisted=$(cli_json profile-persisted debug localapi GET /localapi/v0/profiles/current) || return 1
  # Logout deletes the current profile, but its persisted profile index remains.
  # That history also retires freshness if login/logout happened between starts.
  if [ "$persisted" = false ] && [ -s "$STATE_FILE" ]; then
    persisted=$(json_read profile-history < "$STATE_FILE") || return 1
  fi
  if [ "$persisted" = true ]; then
    : > "$HOSTNAME_MARKER"
    rm -f "$FRESH_MARKER" "$FRESH_APPLIED"
    return 0
  fi
  # Fresh profile prefs are memory-only until authentication supplies a profile ID/Key.
  # Apply once per owned daemon generation, not again after a user's explicit set.
  cmp -s "$DAEMON_PID" "$FRESH_APPLIED" && return 0
  prefs=$(cli_json prefs debug prefs) || return 1
  current=$(printf '%s' "$prefs" | json_read hostname)
  raw_name="$DEVICE_HOSTNAME"
  [ -n "$raw_name" ] || raw_name=$(bounded 1 settings get global device_name 2>/dev/null)
  case "$raw_name" in null | unknown) raw_name= ;; esac
  hostname=$(hostname_slug "$raw_name")
  if [ -z "$hostname" ]; then hostname=$(hostname_slug "$(bounded 1 getprop ro.product.name 2>/dev/null)"); fi
  if [ -z "$hostname" ]; then hostname=$(hostname_slug "$(bounded 1 getprop ro.product.model 2>/dev/null)"); fi
  [ -n "$hostname" ] || hostname=android
  case "$current" in '' | localhost) ;; *) hostname="$current" ;; esac
  if bounded "$KST_CLI_TIMEOUT" "$TAILSCALE_BIN" --socket="$SOCKET_FILE" set --hostname="$hostname" \
    --accept-dns=false --accept-routes=false --exit-node= --advertise-routes= >/dev/null 2>&1; then
    cp "$DAEMON_PID" "$FRESH_APPLIED" || return 1
    log INFO 'Applied fresh hostname and conservative DNS/route preferences pending first profile persistence'
  else
    log ERROR 'Fresh preference initialization failed before interactive login'
    return 1
  fi
}

daemon_health() { daemon_running && socket_ready; }

daemon_stop() {
  local status=0
  stop_owned "$DAEMON_PID" "$TAILSCALED_BIN" "--socket=$SOCKET_FILE" || status=1
  if [ "$status" = 1 ]; then
    # A retained process record owns the socket; keep it on inconclusive stops.
    system_dns_remove_quiet
    return 1
  fi
  stop_logger tailscaled || status=1
  if [ "$status" = 0 ]; then rm -f "$SOCKET_FILE"; fi
  system_dns_remove_quiet
  return "$status"
}

daemon_start() {
  load_config || { log ERROR "$CONFIG_ERROR"; return 1; }
  if [ "$ENGINE_DIR" != "$BUNDLE_DIR" ]; then engine_verify "$ENGINE_DIR" || return 1; fi
  module_disabled && return 1
  if daemon_running; then
    daemon_health && initialize_hostname || return 1
    system_dns_sync || log WARN 'System-wide DNS is not applied'
    return 0
  fi
  stop_owned "$DAEMON_PID" "$TAILSCALED_BIN" "--socket=$SOCKET_FILE" || return 1
  [ -x "$TAILSCALED_BIN" ] && [ -x "$TAILSCALE_BIN" ] || return 1
  ensure_dirs || return 1
  [ -e "$STATE_FILE" ] || : > "$FRESH_MARKER"
  rm -f "$SOCKET_FILE" "$FRESH_APPLIED"
  local tun="$TUN_NAME" deadline
  [ "$MODE" = userspace ] && tun=userspace-networking
  if [ -n "$CONTROL_PROXY" ]; then
    export HTTP_PROXY="$CONTROL_PROXY" HTTPS_PROXY="$CONTROL_PROXY" NO_PROXY="127.0.0.1,localhost"
  else
    unset HTTP_PROXY HTTPS_PROXY ALL_PROXY http_proxy https_proxy all_proxy
  fi
  # Upstream only infers a state root from --state when its parent is named tailscale.
  if [ "$MODE" = userspace ]; then
    launch_logged tailscaled "$DAEMON_PID" "$TAILSCALED_BIN" "--socket=$SOCKET_FILE" "$TAILSCALED_BIN" \
      --tun="$tun" --socks5-server="$SOCKS_LISTEN" --state="$STATE_FILE" --statedir="$TS_DIR" --socket="$SOCKET_FILE" --port="$TAILSCALE_PORT" --no-logs-no-support || return 1
  else
    launch_logged tailscaled "$DAEMON_PID" "$TAILSCALED_BIN" "--socket=$SOCKET_FILE" "$TAILSCALED_BIN" \
      --tun="$tun" --state="$STATE_FILE" --statedir="$TS_DIR" --socket="$SOCKET_FILE" --port="$TAILSCALE_PORT" --no-logs-no-support || return 1
  fi
  deadline=$(($(date +%s) + KST_START_TIMEOUT))
  while [ "$(date +%s)" -lt "$deadline" ]; do
    if daemon_health; then
      if initialize_hostname; then
        [ ! -f "$STATE_FILE" ] || chmod 0600 "$STATE_FILE"
        system_dns_sync || log WARN 'System-wide DNS is not applied'
        return 0
      fi
      break
    fi
    daemon_running || break
    sleep 0.2
  done
  daemon_stop
  return 1
}

case "$1" in
  start) with_control_lock daemon_start ;;
  stop) with_control_lock daemon_stop ;;
  health) load_config && daemon_health ;;
  *) echo 'usage: tailscale-daemon {start|stop|health}' >&2; exit 2 ;;
esac
