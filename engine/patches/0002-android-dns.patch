+// TestDNSCacheResolver covers the forwarder copied by controlclient and
+// controlhttp, not just net.DefaultResolver. A cache miss must reach Android's
+// resolver and subsequent lookups must use the cached answer.
+func TestDNSCacheResolver(t *testing.T) {
+	for _, legacy := range []bool{false, true} {
+		name := "resnsend"
+		if legacy {
+			name = "getaddrinfo"
+		}
+		t.Run(name, func(t *testing.T) {
+			var served func() int32
+			if legacy {
+				served = startFakeLegacyDaemon(t, legacyLookup).Load
+			} else {
+				var queries atomic.Int32
+				startFakeDaemon(t, func(query []byte) ([]byte, int32) {
+					queries.Add(1)
+					return dnsAnswer(t, query), 0
+				})
+				served = queries.Load
+			}
+
+			tstest.Replace(t, &net.DefaultResolver, &net.Resolver{})
+			// A missed installation fails locally, without consulting host DNS.
+			tstest.Replace(t, &dnscache.Get().Forward, &net.Resolver{
+				PreferGo: true,
+				Dial: func(context.Context, string, string) (net.Conn, error) {
+					return nil, errClosed
+				},
+			})
+			installResolver()
+			cache := &dnscache.Resolver{Forward: dnscache.Get().Forward}
+			ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
+			defer cancel()
+			for i := range 2 {
+				before := served()
+				ip, ip6, all, err := cache.LookupIP(ctx, "example.com.")
+				if err != nil {
+					t.Fatal(err)
+				}
+				want4 := netip.MustParseAddr("1.2.3.4")
+				want6 := netip.MustParseAddr("::6")
+				if ip != want4 || ip6 != want6 || !slices.Contains(all, want4) || !slices.Contains(all, want6) {
+					t.Fatalf("LookupIP = %v, %v, %v; want %v and %v", ip, ip6, all, want4, want6)
+				}
+				if i == 0 && served() == before {
+					t.Fatal("cache miss did not query Android's resolver")
+				}
+				if i == 1 && served() != before {
+					t.Fatal("cache hit queried Android's resolver")
+				}
+			}
+		})
+	}
+}
