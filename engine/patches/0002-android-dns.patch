+func TestAndroidDNSFeature(t *testing.T) {
+	const pkg = "tailscale.com/feature/androiddns"
+	for _, goos := range []string{"linux", "android"} {
+		for _, omit := range []bool{false, true} {
+			tags := ""
+			if omit {
+				tags = "ts_omit_androiddns"
+			}
+			t.Run(goos+"/"+tags, func(t *testing.T) {
+				check := deptest.DepChecker{
+					GOOS:     goos,
+					GOARCH:   "arm64",
+					Tags:     tags,
+					ExtraEnv: []string{"CGO_ENABLED=0"},
+				}
+				if omit {
+					check.BadDeps = map[string]string{pkg: "unexpected with ts_omit_androiddns"}
+				} else {
+					check.WantDeps = set.Of(pkg)
+				}
+				check.Check(t)
+			})
+		}
+	}
+}
