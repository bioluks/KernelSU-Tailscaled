+func TestDefaultRouteFromNetlinkErrors(t *testing.T) {
+	textErr := errors.New("setsockopt: protocol not available")
+	for _, tt := range []struct {
+		name         string
+		strictErr    error
+		fallbackErr  error
+		listErr      error
+		wantErr      error
+		wantContext  string
+		wantAttempts []bool
+	}{
+		{name: "strict-permission", strictErr: fmt.Errorf("dial: %w", unix.EPERM), wantErr: unix.EPERM, wantContext: "Dial", wantAttempts: []bool{true}},
+		{name: "strict-access-denied", strictErr: unix.EACCES, wantErr: unix.EACCES, wantContext: "Dial", wantAttempts: []bool{true}},
+		{name: "strict-not-supported", strictErr: unix.EOPNOTSUPP, wantErr: unix.EOPNOTSUPP, wantContext: "Dial", wantAttempts: []bool{true}},
+		{name: "strict-invalid", strictErr: unix.EINVAL, wantErr: unix.EINVAL, wantContext: "Dial", wantAttempts: []bool{true}},
+		{name: "strict-error-text", strictErr: textErr, wantErr: textErr, wantContext: "Dial", wantAttempts: []bool{true}},
+		{name: "fallback-permission", strictErr: unix.ENOPROTOOPT, fallbackErr: fmt.Errorf("dial: %w", unix.EPERM), wantErr: unix.EPERM, wantContext: "Dial", wantAttempts: []bool{true, false}},
+		{name: "fallback-unsupported-option", strictErr: unix.ENOPROTOOPT, fallbackErr: unix.ENOPROTOOPT, wantErr: unix.ENOPROTOOPT, wantContext: "Dial", wantAttempts: []bool{true, false}},
+		{name: "strict-list-permission", listErr: fmt.Errorf("route dump: %w", unix.EPERM), wantErr: unix.EPERM, wantContext: "List", wantAttempts: []bool{true}},
+		{name: "strict-list-unsupported-option", listErr: unix.ENOPROTOOPT, wantErr: unix.ENOPROTOOPT, wantContext: "List", wantAttempts: []bool{true}},
+		{name: "fallback-list-permission", strictErr: unix.ENOPROTOOPT, listErr: fmt.Errorf("route dump: %w", unix.EPERM), wantErr: unix.EPERM, wantContext: "List", wantAttempts: []bool{true, false}},
+		{name: "fallback-list-io", strictErr: unix.ENOPROTOOPT, listErr: unix.EIO, wantErr: unix.EIO, wantContext: "List", wantAttempts: []bool{true, false}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			c := &testRouteNetlinkConn{
+				routes:  []rtnetlink.RouteMessage{{Attributes: rtnetlink.RouteAttributes{Gateway: net.ParseIP("192.0.2.1"), OutIface: 7}}},
+				listErr: tt.listErr,
+			}
+			var attempts []bool
+			dial := func(config *netlink.Config) (routeNetlinkConn, error) {
+				strict := config != nil && config.Strict
+				attempts = append(attempts, strict)
+				if strict && tt.strictErr != nil {
+					return nil, tt.strictErr
+				}
+				if !strict && tt.fallbackErr != nil {
+					return nil, tt.fallbackErr
+				}
+				return c, nil
+			}
+			got, err := defaultRouteFromNetlinkWith(dial, func(idx int) (*net.Interface, error) {
+				return &net.Interface{Index: idx, Name: "uplink0"}, nil
+			})
+			if !errors.Is(err, tt.wantErr) {
+				t.Fatalf("error = %v, want %v", err, tt.wantErr)
+			}
+			if !strings.HasPrefix(err.Error(), "defaultRouteFromNetlink: "+tt.wantContext+": ") {
+				t.Errorf("error = %v, want %s context", err, tt.wantContext)
+			}
+			if got != (DefaultRouteDetails{}) {
+				t.Errorf("default route on error = %+v, want zero value", got)
+			}
+			if !slices.Equal(attempts, tt.wantAttempts) {
+				t.Errorf("dial Strict options = %v, want %v", attempts, tt.wantAttempts)
+			}
+			if wantClosed := tt.wantContext == "List"; c.closed != wantClosed {
+				t.Errorf("connection closed = %v, want %v", c.closed, wantClosed)
+			}
+		})
+	}
+}
+
+func TestDefaultRouteFromNetlinkNoDefaultRoute(t *testing.T) {
+	for _, strictErr := range []error{nil, unix.ENOPROTOOPT} {
+		t.Run(fmt.Sprint(strictErr), func(t *testing.T) {
+			c := &testRouteNetlinkConn{routes: []rtnetlink.RouteMessage{
+				{Attributes: rtnetlink.RouteAttributes{OutIface: 7}},
+				{DstLength: 24, Attributes: rtnetlink.RouteAttributes{Dst: net.ParseIP("192.0.2.0"), Gateway: net.ParseIP("192.0.2.1"), OutIface: 7}},
+			}}
+			got, err := defaultRouteFromNetlinkWith(func(config *netlink.Config) (routeNetlinkConn, error) {
+				if config != nil && config.Strict && strictErr != nil {
+					return nil, strictErr
+				}
+				return c, nil
+			}, func(idx int) (*net.Interface, error) {
+				return &net.Interface{Index: idx, Name: "not-default"}, nil
+			})
+			if !errors.Is(err, errNoDefaultRoute) {
+				t.Fatalf("error = %v, want %v", err, errNoDefaultRoute)
+			}
+			if got != (DefaultRouteDetails{}) {
+				t.Errorf("default route = %+v, want zero value", got)
+			}
+			if !c.closed {
+				t.Error("route connection was not closed")
+			}
+		})
+	}
+}
+
+type testRouteNetlinkConn struct {
+	routes  []rtnetlink.RouteMessage
+	listErr error
+	closed  bool
+}
+
+func (c *testRouteNetlinkConn) ListRoutes() ([]rtnetlink.RouteMessage, error) {
+	return c.routes, c.listErr
+}
+
+func (c *testRouteNetlinkConn) Close() error {
+	c.closed = true
+	return nil
+}
