+func TestDefaultRouteFromNetlinkRoutes(t *testing.T) {
+	for _, tt := range []struct {
+		name         string
+		strictErr    error
+		wantAttempts []bool
+	}{
+		{"strict", nil, []bool{true}},
+		{"unsupported-option", unix.ENOPROTOOPT, []bool{true, false}},
+		{"wrapped-unsupported-option", fmt.Errorf("netlink dial: %w", os.NewSyscallError("setsockopt", unix.ENOPROTOOPT)), []bool{true, false}},
+	} {
+		t.Run(tt.name, func(t *testing.T) {
+			c := &testRouteNetlinkConn{routes: []rtnetlink.RouteMessage{
+				{Attributes: rtnetlink.RouteAttributes{OutIface: 1}},
+				{DstLength: 24, Attributes: rtnetlink.RouteAttributes{Dst: net.ParseIP("192.0.2.0"), Gateway: net.ParseIP("192.0.2.1"), OutIface: 2}},
+				{Attributes: rtnetlink.RouteAttributes{Gateway: net.ParseIP("192.0.2.1")}},
+				{Attributes: rtnetlink.RouteAttributes{Gateway: net.ParseIP("192.0.2.1"), OutIface: 3}},
+				{Family: unix.AF_INET, Table: 100, Type: unix.RTN_UNICAST, Attributes: rtnetlink.RouteAttributes{Gateway: net.ParseIP("192.0.2.1"), OutIface: 7}},
+				{Family: unix.AF_INET6, Type: unix.RTN_UNICAST, Attributes: rtnetlink.RouteAttributes{Gateway: net.ParseIP("fe80::1"), OutIface: 8}},
+			}}
+			var attempts []bool
+			dial := func(config *netlink.Config) (routeNetlinkConn, error) {
+				strict := config != nil && config.Strict
+				attempts = append(attempts, strict)
+				if strict && tt.strictErr != nil {
+					return nil, tt.strictErr
+				}
+				return c, nil
+			}
+			interfaceByIndex := func(idx int) (*net.Interface, error) {
+				switch idx {
+				case 1, 2:
+					return &net.Interface{Index: idx, Name: "not-default"}, nil
+				case 7:
+					return &net.Interface{Index: idx, Name: "uplink0"}, nil
+				case 8:
+					return &net.Interface{Index: idx, Name: "uplink6"}, nil
+				default:
+					return nil, errors.New("interface no longer exists")
+				}
+			}
+			got, err := defaultRouteFromNetlinkWith(dial, interfaceByIndex)
+			if err != nil {
+				t.Fatal(err)
+			}
+			want := DefaultRouteDetails{InterfaceName: "uplink0", InterfaceIndex: 7}
+			if got != want {
+				t.Errorf("default route = %+v, want %+v", got, want)
+			}
+			if !slices.Equal(attempts, tt.wantAttempts) {
+				t.Errorf("dial Strict options = %v, want %v", attempts, tt.wantAttempts)
+			}
+			if !c.closed {
+				t.Error("route connection was not closed")
+			}
+		})
+	}
+}
